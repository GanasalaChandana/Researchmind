# Required
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
DATABASE_URL=postgresql://researchmind:researchmind@localhost:5432/researchmind
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production (Railway / ENV=production) if this is unset.
JWT_SECRET_KEY=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Optional
REDIS_URL=
RESEND_API_KEY=            # required in production for password-reset emails
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local development ONLY: return the password-reset token in the API response
# instead of emailing it. The app refuses to start in production with this on.
# ALLOW_DEV_RESET_TOKEN=true
