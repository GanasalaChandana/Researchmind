{
  "expo": {
    "name": "ResearchMind",
    "slug": "researchmind-mobile",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "researchmind",
    "userInterfaceStyle": "dark",
    "description": "AI-powered research agent in your pocket",
    "homepage": "https://researchmind-app.vercel.app",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.researchmind.mobile",
      "supportsTabletMode": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "ResearchMind needs access to your local network",
        "NSBonjourServiceTypes": [
          "_http._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.researchmind.mobile",
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
